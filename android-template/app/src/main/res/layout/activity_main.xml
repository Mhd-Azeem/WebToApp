<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F5F7FB">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WebToApp Builder" android:textColor="#111827" android:textSize="28sp" android:textStyle="bold"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="20dp" android:text="Enter a website and build an installable Android APK" android:textColor="#6B7280" android:textSize="15sp"/>
  <EditText android:id="@+id/websiteUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Website URL (https://example.com)" android:inputType="textUri" android:padding="14dp" android:textColor="#111827" android:textColorHint="#6B7280"/>
  <EditText android:id="@+id/appName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="App name" android:inputType="textCapWords" android:padding="14dp" android:textColor="#111827" android:textColorHint="#6B7280"/>
  <EditText android:id="@+id/packageName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Package name (com.example.app)" android:inputType="textNoSuggestions" android:padding="14dp" android:textColor="#111827" android:textColorHint="#6B7280"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Orientation" android:textColor="#111827" android:textSize="17sp" android:textStyle="bold"/>
  <RadioGroup android:id="@+id/orientationGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
   <RadioButton android:id="@+id/orientationAuto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#374151" android:checked="true"/>
   <RadioButton android:id="@+id/orientationPortrait" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Portrait" android:textColor="#374151"/>
   <RadioButton android:id="@+id/orientationLandscape" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Landscape" android:textColor="#374151"/>
  </RadioGroup>
  <Button android:id="@+id/buildButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="24dp" android:text="BUILD APK" android:textStyle="bold"/>
  <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone"/>
  <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Ready to build" android:textColor="#374151" android:textSize="14sp"/>
  <Button android:id="@+id/previewButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:text="PREVIEW WEBSITE"/>
  <Button android:id="@+id/githubButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="CONNECT / CHANGE GITHUB TOKEN"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingBottom="24dp" android:text="The token is never included in generated APKs. Generated APKs are built by your GitHub Actions workflow." android:textColor="#6B7280" android:textSize="12sp"/>
 </LinearLayout>
</ScrollView>